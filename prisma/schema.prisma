// Prisma Schema for Inuka Africa Loan Repayment Tracker
// Datasource: MySQL Relational Database
// Financial records enforce decimal precision and foreign key integrity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id             String      @id @default(uuid())
  clientNumber   String      @unique @map("client_number") @db.VarChar(50)
  fullName       String      @map("full_name") @db.VarChar(255)
  phone          String?     @db.VarChar(30)
  email          String?     @db.VarChar(255)
  location       String?     @db.VarChar(255)
  dateRegistered DateTime    @default(now()) @map("date_registered")
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  loans          Loan[]
  repayments     Repayment[]

  @@map("clients")
  @@index([clientNumber])
  @@index([fullName])
}

model Loan {
  id                 String      @id @default(uuid())
  loanReference      String      @unique @map("loan_reference") @db.VarChar(50)
  clientId           String      @map("client_id")
  loanAmount         Decimal     @map("loan_amount") @db.Decimal(12, 2)
  totalAmountDue     Decimal     @map("total_amount_due") @db.Decimal(12, 2)
  purpose            String?     @db.VarChar(255)
  loanDate           DateTime    @default(now()) @map("loan_date")
  dueDate            DateTime?   @map("due_date")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  client             Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  repayments         Repayment[]

  @@map("loans")
  @@index([clientId])
  @@index([loanReference])
  @@index([loanDate])
}

model Repayment {
  id               String      @id @default(uuid())
  paymentReference String      @unique @map("payment_reference") @db.VarChar(50)
  loanId           String      @map("loan_id")
  clientId         String      @map("client_id")
  amount           Decimal     @db.Decimal(12, 2)
  paymentDate      DateTime    @default(now()) @map("payment_date")
  paymentMethod    String?     @default("M-Pesa") @map("payment_method") @db.VarChar(50)
  notes            String?     @db.VarChar(255)
  dateRecorded     DateTime    @default(now()) @map("date_recorded")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  loan             Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  client           Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("repayments")
  @@index([loanId])
  @@index([clientId])
  @@index([paymentReference])
  @@index([paymentDate])
}

model AIInteraction {
  id               String      @id @default(uuid())
  question         String      @db.Text
  intent           String?     @db.VarChar(100)
  response         String      @db.Text
  model            String      @db.VarChar(100)
  verifiedDataJson String?     @map("verified_data_json") @db.Text
  createdAt        DateTime    @default(now()) @map("created_at")

  @@map("ai_interactions")
}

model AIReport {
  id           String      @id @default(uuid())
  reportType   String      @map("report_type") @db.VarChar(100)
  period       String      @db.VarChar(50)
  title        String      @db.VarChar(255)
  contentJson  String      @map("content_json") @db.MediumText
  generatedAt  DateTime    @default(now()) @map("generated_at")

  @@map("ai_reports")
}
