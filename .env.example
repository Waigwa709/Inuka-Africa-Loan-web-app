# Inuka Africa Loan Repayment Tracker - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database (required) ---
# Preferred: single connection string.
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/inukaloanapp"
# Alternative: discrete variables (used only when DATABASE_URL is not set).
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_USER="root"
# DB_PASSWORD="YOUR_PASSWORD"
# DB_NAME="inukaloanapp"

# --- Authentication (required for stable sessions) ---
# Secret used to sign session tokens. Generate a long random string.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
# Optional: seed the first administrator account on first startup.
# ADMIN_EMAIL="admin@inuka.co.ke"
# ADMIN_PASSWORD="CHANGE_ME"
# ADMIN_NAME="System Administrator"

# --- AI Provider (optional; app works with deterministic fallback without it) ---
# GEMINI_API_KEY: Google Gemini API key for live AI features.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# AI_PROVIDER: "gemini" (default) or "openai"
AI_PROVIDER="gemini"
# OPENAI_API_KEY: only needed when AI_PROVIDER=openai
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# --- Server ---
# PORT="3002"
